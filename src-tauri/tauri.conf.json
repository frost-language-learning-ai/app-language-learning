{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LanguageLearning",
  "version": "0.1.0",
  "identifier": "com.frost.languagelearning",
  "build": {
    "beforeDevCommand": "npm run react:start",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run react:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Language Learning",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../server",
      "../node_modules",
      "../data"
    ],
    "icon": [
      "../build/icons/icon.ico",
      "../build/icons/icon.icns",
      "../build/icons/icon-256.png"
    ]
  }
}
